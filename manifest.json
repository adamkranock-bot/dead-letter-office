{
	"manifest_version": 3,
	"name": "Dead Letter Office",
	"version": "2.0.0",
	"version_name": "1.2.0",
	"description": "A searchable, exportable archive of your Reddit private messages.",
	"icons": {
		"16": "images/icons/16.png",
		"32": "images/icons/32.png",
		"48": "images/icons/48.png",
		"128": "images/icons/128.png"
	},
	"permissions": [
		"storage",
		"unlimitedStorage",
		"alarms"
	],
	"host_permissions": [
		"https://*.reddit.com/*"
	],
	"web_accessible_resources": [
		{
			"resources": [
				"template/*",
				"images/*",
				"fonts/*"
			],
			"matches": [
				"https://*.reddit.com/*"
			]
		}
	],
	"content_scripts": [
		{
			"matches": [
				"https://*.reddit.com/*"
			],
			"css": [
				"css/notification_icons.css"
			],
			"js": [
				"js/global/extension-scanner.js",
				"js/content-all/notification_icons.js"
			],
			"run_at": "document_start"
		},
		{
			"matches": [
				"https://*.reddit.com/message/dlo_*",
				"https://*.reddit.com/message/yair_*"
			],
			"css": [
				"css/dlo.css"
			],
			"js": [
				"js/content-inbox/jquery-3.7.1.min.js",
				"js/global/constants.js",
				"js/global/time.js",
				"js/global/extension-scanner.js",
				"js/content-inbox/global.js",
				"js/content-inbox/alerts.js",
				"js/content-inbox/config.js",
				"js/content-inbox/generic.js",
				"js/content-inbox/search.js",
				"js/content-inbox/view-shell.js",
				"js/content-inbox/view-list.js",
				"js/content-inbox/view-conversation.js",
				"js/content-inbox/view-settings.js",
				"js/content-inbox/keyboard.js",
				"js/content-inbox/controller.js",
				"js/content-inbox/controller-data.js",
				"js/content-inbox/model.js",
				"js/content-inbox/dbhelper.js",
				"js/content-inbox/main.js"
			],
			"run_at": "document_start"
		}
	],
	"background": {
		"service_worker": "js/background/service-worker.js",
		"scripts": [
			"js/global/constants.js",
			"js/background/bg-global.js",
			"js/background/bg-storage.js",
			"js/background/bg-config.js",
			"js/background/bg-indexeddb.js",
			"js/background/bg_fetch.js",
			"js/background/bg-proxy.js"
		]
	},
	"action": {
		"default_title": "Dead Letter Office",
		"default_popup": "template/notifications_panel.html",
		"default_icon": {
			"16": "images/icons/16.png",
			"32": "images/icons/32.png"
		}
	},
	"minimum_chrome_version": "121",
	"browser_specific_settings": {
		"gecko": {
			"strict_min_version": "121.0"
		}
	},
	"short_name": "DLO"
}
